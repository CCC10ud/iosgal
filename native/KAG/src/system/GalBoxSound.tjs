// GalBoxSound.tjs — GalBox 自写的 `MIDISoundBuffer` 骨架（**非官方**，Milestone 2e-25）
//
// 官方 `MIDISoundBuffer` 是 kirikiri2/src/core/sound/MidiSoundBuffer.cpp 里的
// **原生类**（绑死 Windows MIDI API）。KAG 的音频脚本 `BGM.tjs` 第 114 行：
//
//   class KAGMIDISoundBuffer extends MIDISoundBuffer, KAGSoundBuffer
//
// 没有 MIDISoundBuffer，BGM.tjs 的类定义链就断在这 —— M2e-24 补上
// cursorX/cursorY 后，run 44216212216 实测的阻塞点正是
// `Member "MIDISoundBuffer" does not exist` @ BGM.tjs:114。
// 这是启动链**首次跳出 Layer/Window 视觉领域**，进入音频类领域。
//
// 与 GalBoxWindow.tjs 同理：这是**过渡骨架**，只让类名可解析（global 上有
// 类对象）、基类构造可调用，把下一批缺口（fade / stop / status / midiOut 等
// 成员，见 BGM.tjs:65/74/77/87/287 对 sbclass 的调用）逼出来。
// 它**不发声、不碰 MIDI 设备**。WaveSoundBuffer / CDDASoundBuffer 同族类
// 等 BGM/SE 执行路径实测需要时再补（一个里程碑跨一个停点）。

// M2E25_BEGIN —— NOMIDI 负向对照按**文件级**删除（同 M2e-7/11/12 模式）：
// 整个 GalBoxSound.tjs 不放进夹具，必须复现 MIDISoundBuffer@BGM.tjs:114。
class MIDISoundBuffer
{
	var owner;
	// M2E29A_BEGIN —— NOPAUSED 负向对照按此标记整段删除
	// 官方 SoundBufferIntf 的**暂停位** paused（bool）。真实使用点在
	// BGM.tjs:585 `dic.paused = buf1.paused;`（store() 存状态）与
	// BGM.tjs:309 `buf.paused = paused;`（playBuffer）—— 注意这是对
	// **类实例**的属性访问，缺了就抛 MemberNotFound（与 M2e-28 发现的
	// `this.xxx` 代理返回 void 不同）、链路真实停止。
	var paused = false;
	// M2E29A_END
	function MIDISoundBuffer(o)
	{
		owner = o;
	}
}
// M2E25_END

// M2E26_BEGIN —— NOWAVE 负向对照按此标记整段删除
// 官方 WaveSoundBuffer 是 kirikiri2/src/core/sound/WaveSoundBuffer.cpp 里的
// 原生类（WAV/OGG 解码 + 播放，绑死 Windows 音频 API）。两处用名：
//   SE.tjs:4   `class SESoundBuffer extends WaveSoundBuffer`（效果音基类）
//   BGM.tjs:95 `class KAGWaveSoundBuffer extends WaveSoundBuffer, KAGSoundBuffer`
//   SE.tjs:19  `super.WaveSoundBuffer(owner);`（super 链调基类构造）
// M2e-25 补上 MIDISoundBuffer 后启动链停在 SE.tjs:4。
//
// 同 MIDISoundBuffer：过渡骨架，只让类名可解析 + 构造可调；
// play / stop / status / volume / fade 等成员等实测停点再补。
class WaveSoundBuffer
{
	var owner;
	// M2E30_BEGIN —— NOPAN 负向对照按此标记整段删除
	// 官方 SE.tjs:213-223 定义了 `property pan`（setter 写 super.pan = x*1000，
	// getter 读 super.pan \ 1000）—— 即**基类** WaveSoundBuffer 上的整数 pan，
	// 单位 1/1000（-1000 左 / 0 中 / 1000 右）。A 场景实测停点：
	// `Member "pan" does not exist @ SE.tjs:221`。
	// 只给 Wave 一份：MIDI 侧目前无证据（BGM 用 audioBalance），等实测再补。
	var pan = 0;
	// M2E30_END
	// M2E29B_BEGIN —— NOPAUSED 负向对照按此标记整段删除
	// 同 MIDISoundBuffer：Wave 缓冲区也有 paused（BGM.tjs:393/400
	// `buf1.paused = true/false;` 在 pause/resume 路径上）。
	var paused = false;
	// M2E29B_END
	function WaveSoundBuffer(o)
	{
		owner = o;
	}
}
// M2E26_END
