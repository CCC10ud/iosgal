// GalBoxKAGParser.tjs — GalBox 自写的 `KAGParser` 骨架（**非官方**，Milestone 2e-11）
//
// 官方 `KAGParser` 是 KAG3 里的原生类（KAGParser.cpp，脚本解析器本体：
// 读 scenario、按标签跳转、中断/恢复、状态存取）。run 44049497384（M2e-10）
// 实测的下一缺口是**类定义阶段**（不是实例化阶段）的：
//     Member "KAGParser" does not exist @ Conductor.tjs:13
//     (class BaseConductor extends KAGParser)
//
// 与其他骨架不同：这里在 `extends KAGParser` 求值时就需要类存在，所以文件
// 必须比 Conductor.tjs 更早装载。逐条统计官方 Conductor.tjs 对父类的用法，
// 通过 super 调用的只有下面 8 个成员：
//   KAGParser()（构造）/ finalize() / clear() / assign(src) / store() /
//   restore(dic) / loadScenario() / goToLabel()
// 官方脚本没有直接读 KAGParser 的字段（context/pos 等），全走 super 方法。
//
// 骨架只让 BaseConductor 能继承、实例化并调用这些 super 方法；不真解析
// scenario、不维护标签表、不存取状态。store() 返回空字典（官方返回状态字典），
// 让 `return super.store(...)` 的调用方拿得到东西而不报错。
//
// ⚠️ TJS2 语法雷（M2e-3 踩过）：方法定义不要用 `...` 变参；`...` 只出现在
// **调用方**（官方 super.xxx(...) 是转发实参），骨架这边用普通形参即可。

class KAGParser
{
	// M2E13_BEGIN
	// M2e-13：官方 Conductor.tjs:350 / AnimationLayer.tjs:266 在构造里给
	// `debugLevel` 赋值（tkdlVerbose / tkdlNone）。TJS2 的类实例**不能**
	// 凭空加成员，赋值会抛
	//     Member "debugLevel" does not exist @ AnimationLayer.tjs:266
	// （run 44057349589 实测，链在 AnimationLayer.tjs 上就断了）。
	//
	// 全项目统计：debugLevel 只有 2 处**赋值**、0 处**读取** —— 它只是官方
	// 从 tTVPKAGDebugLevel 抄下来的调试等级槽位，没有任何行为挂在上面。
	// 因此这里只声明不实现：给它一个可写成员，赋值不再抛异常即可。
	//
	// 为什么不改官方 Conductor.tjs：那是被测对象，改它等于把缺口「改掉」，
	// 后面所有判据都失去意义。缺的东西只能补在 GalBox 侧的骨架上。
	var debugLevel;
	// M2E13_END

	function KAGParser()
	{
	}

	function finalize() {}

	function clear() {}

	function assign(src) {}

	function store()
	{
		// 官方返回状态字典；给空字典让 `return super.store(...)` 拿得到值。
		return %[];
	}

	function restore(dic) {}

	function loadScenario() {}

	function goToLabel() {}

	// M2E40_BEGIN —— NORESINT 负向对照按此标记整段删除
	// 官方 KAGParser 原生类的 resetInterrupt()：清除中断状态。官方
	// Conductor.tjs 只在 startProcess() 213 行裸标识符调用一次
	// `resetInterrupt();`，不定义、无返回值依赖 ⇒ 父类 KAGParser 的方法。
	// 骨架里给一个空实现即可让调用不抛 Member 错。
	function resetInterrupt() {}
	// M2E40_END

	// M2E41_BEGIN —— NOCURSTOR 负向对照按此标记整段删除
	// 官方 KAGParser 原生类的 curStorage：当前正在解析的 scenario 文件名。
	// 官方 Conductor.tjs:180 在 timerCallback() 的 catch 里裸标识符读它
	//（`"ファイル : " + curStorage + ...`）⇒ 缺失即抛
	//     Member "curStorage" does not exist @ Conductor.tjs:180
	// BaseConductor 自身没有该成员（class BaseConductor extends KAGParser，
	// 官方脚本只在 180 行读、从不写），MainWindow.tjs 那边是
	// `conductor.curStorage` 形式读取 —— 故属父类 KAGParser 的槽位。
	// 骨架给一个空串占位，让异常信息能拼出来而不抛 Member 错。
	var curStorage = "";
	// M2E41_END

	// M2E42_BEGIN —— NOCURLINE 负向对照按此标记整段删除
	// 官方 KAGParser 原生类的 curLine：当前正在解析的 scenario 行号。
	// 官方 Conductor.tjs:180 与 curStorage 在**同一行**里并列出现
	//（`"ファイル : " + curStorage + "   行 : " + (curLine+1)`），
	// 而 TJS2 的字符串拼接从左到右求值 ⇒ 补完 curStorage 后，下一个缺口
	// 就是 curLine@180（行号不变、变量换了）。
	// 官方脚本全仓只在此处读它一次、从不写 ⇒ 父类 KAGParser 的槽位。
	// 骨架给 0 占位，让异常信息能拼出来而不抛 Member 错。
	var curLine = 0;
	// M2E42_END

	// M2E43_BEGIN —— NOGETNEXT 负向对照按此标记整段删除
	// 官方 KAGParser 原生类的 getNextTag()：取下一个 scenario 标签对象。
	// 官方 Conductor.tjs:81 在 timerCallback() 里裸标识符调用一次
	//（`obj = getNextTag();`），全仓只调不定义 ⇒ 父类 KAGParser 的方法。
	//
	// 返回值语义（关键）：官方脚本 91 行紧跟着
	//     if(obj === void) { ... シナリオ終了 ... return; }
	// ⇒ getNextTag() 在没有更多标签时必须返回 **void**，官方才走"结束"分支。
	// 骨架不真解析 scenario，所以恒返回 void：让 91 行判定成立，
	// timerCallback 走完 onStop() 正常收尾，而不是掉进 onTag(obj) 分支
	// 去读 obj.tagname（那样会立刻炸出下一个缺口）。
	//
	// TJS2 语义依据（引擎源码实测）：tjsInterCodeGen.cpp 的 `case T_VOID:
	// return 0; // 0 is always void`；ReturnFromFunc() 里 `if(!node)`
	// 无 return 表达式时返回 register #0 = void。写 `return void;` 是
	// 显式版本，与官方脚本里 `return void;` 的写法一致。
	function getNextTag() { return void; }
	// M2E43_END
}
