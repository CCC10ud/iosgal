// GalBoxMovie.tjs — GalBox 自写的 `VideoOverlay` 骨架（**非官方**，Milestone 2e-27）
//
// 官方 `VideoOverlay` 是 kirikiri2/src/core/visual/VideoOverlay.cpp 里的
// **原生类**（Windows 上走 DirectShow / WMV，绑死 tp_stub）。KAG 的影片脚本
// `Movie.tjs` 第 4 行就是 `class Movie extends VideoOverlay`，第 16 行
// `super.VideoOverlay(...)` 用 super 链调基类构造。
//
// M2e-26 补上 WaveSoundBuffer 后，run 44298320673 实测的阻塞点正是
// `Member "VideoOverlay" does not exist` @ Movie.tjs:4。
// 这是音频领域之后紧接着的**影片播放领域**（Movie.tjs 另带播放/停止/
// 状态查询/层叠加等大面）。
//
// 与 GalBoxSound.tjs 同理：**过渡骨架**，只让类名可解析、基类构造可调用。
// Movie.tjs 里大量成员（mode / visible / loop / frame / numberOfAudioStream /
// audioBalance / audioVolume / enabledAudioStream / segmentLoopFrame /
// playRate / open / play / stop / status …）等执行路径实测逼出来再补，
// 不预置猜测性实现。

// M2E27_BEGIN —— NOVIDEO 负向对照按**文件级**删除（同 M2e-25 模式）：
// 整个 GalBoxMovie.tjs 不放进夹具，必须复现 VideoOverlay@Movie.tjs:4。
class VideoOverlay
{
	var owner;
	// M2E31_BEGIN —— NOMODE 负向对照按此标记整段删除
	// 官方 VideoOverlay 的**播放模式** mode（vomOverlay=0 / vomLayer=1 / vomMixer=2，
	// 常量表 GalBoxConsts.tjs:42 已逐字提供）。A 场景实测停点：
	// `Member "mode" does not exist @ Movie.tjs:30`（store() 里 `dic.mode = mode;`）。
	// 全库 mode 读写都在 Movie.tjs（30/31/62/64/181/193/269/273）⇒ 普通实例成员，
	// 无 super 访问 ⇒ var 即可（对比 M2e-30 的 pan 必须 property）。
	// 初值取 vomLayer(1)：Movie 默认把影片画在图层上，overlay 是显式选项。
	var mode = vomLayer;
	// M2E31_END
	// M2E33_BEGIN —— NOVISIBLE 负向对照按此标记整段删除
	// 官方 VideoOverlay 的可见性标志 visible（影片图层是否显示，true/false）。
	// A 场景实测停点：`Member "visible" does not exist @ Movie.tjs:33`
	// （store() 里 `dic.visible = visible;`，253 行 restore() 里再写回）。
	// 官方脚本全是裸标识符读写（无 this./super.）⇒ 普通实例成员 ⇒ var 即可
	// （对比 M2e-30 的 pan 必须 property）。初值 true：图层默认可见。
	var visible = true;
	// M2E33_END
	function VideoOverlay(o = void)
	{
		owner = o;
	}
}
// M2E27_END
