// GalBoxLayer.tjs — GalBox 自写的 `Layer` 骨架（**非官方**，Milestone 2e-2）
//
// 官方 `Layer` 是 kirikiri2/src/core/visual/LayerIntf.cpp 里的**原生类**
// （293 KB，绑死 Windows 的 tp_stub，无法直接移植）。而 KAG 的 20 个系统脚本里
// 有 18 个写着 `extends Layer`，没有 Layer 就一个都跑不起来 —— run #34 已经把
// 根因钉死在 `KAGLayer.tjs:87` 的 `Member "Layer" does not exist`。
//
// 本文件是**过渡骨架**：纯 TJS2 脚本，只提供让 `class KAGLayer extends Layer`
// 能成立所需的成员占位，从而把「接下来还缺哪个原生成员」一条条逼出来。
// 它**不渲染、不解码图片、不做转场**，离能显示画面还差得很远。
//
// 为什么用脚本而不是原生类：TJS2 里脚本类的继承由引擎自己实现（super proxy），
// 而原生类被脚本继承时，`super.<ctor>()` 会在**脚本实例**上取原生实例 ——
// 那条路径需要另外一套原生实例注册机制。先用脚本骨架把缺口清单逼出来，
// 等清单齐了再决定哪些成员值得做成真正的原生类。
//
// 数值来源：
//   clNone / clAdapt 取自官方 LayerIntf.cpp 的注释
//     0x1fffffff = clNone （不应用颜色键 / 用图像 alpha）
//     0x01ffffff = clAdapt（自适应颜色键）
//   stt* / stst* 是转场方向与停留方式的枚举，官方定义在原生层内部；
//   这里给占位值，因为当前不做转场渲染。

// 颜色键(clNone/clAdapt)与转场枚举(stt*/stst*)**不再在这里自造** ——
// 官方常量表 native/KAG/src/system/GalBoxConsts.tjs 逐字提供了它们
// （M2e-2 时这里自造过，而且把 ststStaySrc / ststStayDest 的值**弄反了**：
//  官方是 StayDest=1、StaySrc=2）。官方常量表用的是 TJS2 的 `const`，
// 与本文件的 `global.xxx =` 同名会冲突，所以只能留一份。

// ---------------------------------------------------------------- Layer 本体
class Layer
{
	var visible = true;
	var left = 0;
	var top = 0;
	var width = 0;
	var height = 0;
	var opacity = 255;
	var absolute = 0;
	var type = 0;

	// M2E14_BEGIN —— M2e-14 负向对照（NOHITTYPE）按此标记整段删除
	// 官方 LayerIntf.cpp 的**命中测试面**：hitType + hitThreshold。
	// GraphicLayer.tjs:337-338 里 BaseLayer 构造连着写这两行：
	//     hitType = htMask;  hitThreshold = 0;
	// 其他子类还会**跨对象**写（MessageLayer.tjs:528 `lineLayer.hitType = htMask;`），
	// 说明它必须是实例成员而不是全局变量，否则所有图层会共用一个值。
	//
	// hitType = htMask 用的是官方常量表（M2e-4）里的 tTVPHitType：htMask=0 /
	// htProvince=1。这里刻意写常量名而不是 0 —— 常量表一旦回归，这一行会立刻
	// 报错，比只写裸数字多一层自检。
	var hitType = htMask;
	// M2E14_THRESHOLD_BEGIN —— NOHITTHRESHOLD 负向对照只删这一行
	// hitThreshold 与 hitType 不同：ButtonLayer.tjs:53 有 `hitThreshold = src.hitThreshold;`
	// ——它是**被读的**。所以不能留 void，必须给官方默认值 0（0 = 全域不透明；
	// 256 = 完全透过鼠标消息，见 AnimationLayer.tjs:1186）。
	var hitThreshold = 0;
	// M2E14_THRESHOLD_END
	// M2E14_END

	// M2E15_BEGIN —— M2e-15 负向对照（NOIMAGESIZE）按此标记整段删除
	// 官方 LayerIntf.cpp 的**图像面**：imageWidth/imageHeight 是原生属性，
	// setImageSize() 写它们，setSizeToImageSize() 再把图层尺寸对齐到图像尺寸。
	//
	// MainWindow.tjs:348-353 建表/裏两张背景层时连着调这几个方法：
	//     fore.base.setImageSize(scWidth, scHeight);
	//     fore.base.setSizeToImageSize();
	// 两者是**两个不同的概念**，不能合并成一个：图像尺寸是源图缓冲的大小，
	// 图层尺寸是显示框的大小（KAG 会先在图像里画，再按图层框裁切/缩放）。
	// 这里不做渲染，所以只把两个尺寸各自存住，让脚本层的算术自洽。
	//
	// 为什么要给真值 0 而不是留 void：KAGLayer.tjs:334-335 的 store() 会
	// `dic.imageWidth = imageWidth;` 原样拷走 —— void 会被一路带进
	// restore() 的 setImageSize(dic.imageWidth, dic.imageHeight)，之后
	// width/height 就算出 NaN 级污染，且不会报错（静默错）。
	var imageWidth = 0;
	var imageHeight = 0;

	function setImageSize(w, h)
	{
		imageWidth = w;
		imageHeight = h;
	}

	// M2E15_SIZETO_BEGIN —— NOSIZETOIMAGESIZE 负向对照只删这一个方法
	// 官方语义：把图层尺寸直接对齐到图像尺寸（不含 imageLeft/imageTop 偏移）。
	function setSizeToImageSize()
	{
		width = imageWidth;
		height = imageHeight;
	}
	// M2E15_SIZETO_END
	// M2E15_END

	// M2E16_FACE_BEGIN —— NODRAWFACE 负向对照只删这一个成员
	// 官方 LayerIntf.cpp 的**绘制面**成员 face（tTVPDrawFace）。
	// GraphicLayer.tjs:422 在 clearImage() 里 `face = dfAlpha;`，紧接着
	// 423 行 fillRect()。这条路径由 MainWindow.tjs:356 的
	// `fore.base.freeImage()` → AnimationLayer.freeImage() → clearImage() 走到。
	//
	// 用法统计：**25 处赋值 / 1 处读取**。唯一的读是 KAGLayer.tjs:376
	// `var lastface = face, lastha = holdAlpha;`（fillOperateRect 里存档-恢复），
	// 所以它跟 hitThreshold 同型：主要被写，但**必须给真值**，
	// 否则恢复回去的是 void，后续 `face = lastface` 就把 void 写回绘制面。
	//
	// 初值取 dfAuto(128) 的依据在官方脚本里：AnimationLayer.tjs:369-372 的
	// clearImage() 是 `face = dfAlpha; fillRect(...); type = ltOpaque; face = dfAuto;`
	// —— 画完就**回到 dfAuto**，说明 dfAuto 才是常态默认值（不是 dfAlpha）。
	var face = dfAuto;
	// M2E16_FACE_END

	// M2E16_FILLRECT_BEGIN —— NOFILLRECT 负向对照只删这一个方法
	// 官方 Layer 的绘制入口。全项目 13 处调用，5 个参数
	// (left, top, width, height, color)，另有一个可选的合成模式。
	// 骨架不渲染，所以这里只提供一个可被调用的空实现；参数名照官方签名写，
	// 便于以后接真绘制时一眼对得上。
	function fillRect(l, t, w, h, color, mode) {}
	// M2E16_FILLRECT_END

	// M2E17_BEGIN —— NOCURSOR 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**光标面**成员 cursor（tTVPCursorType）。
	// 官方 GraphicLayer.tjs:56 定义 setDefaultCursor(c) { cursor = defaultCursor = c; }
	// —— `cursor` 是全脚本里**没有任何 var 声明**的那个（GraphicLayer.tjs:13 的
	// `var cursor;` 属于上面的 ProvinceContext，不是 GraphicLayer，别误判成已声明）。
	// MainWindow.tjs:359-360 给表/裏两张背景层各调一次 setDefaultCursor，
	// 所以这一句是启动链必经之路。
	//
	// 用法统计：**19 处赋值 / 4 处读取**。读里有两处是真读值、不是读 defaultCursor：
	//   GraphicLayer.tjs:138  `tmp = src.cursor; src.cursor = cursor;`（comp 图层互换）
	//   MessageLayer.tjs:2208 `if(cursor == window.cursorPointed) cursor = crDefault;`
	// 第二处是**比较** —— 留 void 就变成 `void == 0` 的假值语义，永远进不了分支，
	// 且不报错。所以必须给真值。
	//
	// 初值取 crDefault(0) 的依据在官方脚本里：GraphicLayer.tjs:31
	// `var defaultCursor = crDefault;`（注释「デフォルトのカーソル」），
	// 而 setDefaultCursor 把 cursor 与 defaultCursor 写成同一个值 ——
	// 没设过默认光标时，cursor 就应该是 defaultCursor 的初值。
	// cr* 常量族来自官方常量表 GalBoxConsts.tjs:46（M2e-4），不在这里自造。
	var cursor = crDefault;
	// M2E17_END

	// M2E18_BEGIN —— NONAME 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**图层名**属性 name（字符串）。
	// HistoryLayer.tjs:110 构造时 `name = "メッセージ履歴レイヤ";`，
	// M2e-17 补上 cursor 后启动链正好停在这一句。
	//
	// 必须是**实例成员**：官方有两处 comp 图层互换——
	//   GraphicLayer.tjs:134-136 / MessageLayer.tjs:2913-2915
	//   `var tmp = src.name; src.name = name; name = tmp;`
	// 写成全局会让两张图层共用一个名字，互换等于没换。
	// 另有多处跨对象赋值：`lineBreak.name = "行クリック待ち記号"`（MainWindow:392）、
	// `tempLayer.name = "一時ワークレイヤ"`（MainWindow:727）。
	//
	// 必须是**字符串真值**而不是 void：MainWindow.tjs:3219
	// `'anim:' + layer.name + ':' + seg` 拿它做字符串拼接并当 conductor 键，
	// void 会拼出 `(void)` 或污染键名，且不一定抛异常（静默错）。
	// 取空串 "" 是 LayerIntf 的 TJSString 默认态：无名字时是空串，不是无值。
	var name = "";
	// M2E18_END

	// M2E19_BEGIN —— NOFOCUSABLE 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**焦点接收面**成员 focusable（bool）。
	// M2e-18 补上 name 后启动链正好停在 HistoryLayer.tjs:130 的
	// `focusable = true;`（HistoryLayer 构造末尾，紧接着 132 行 cursor）。
	//
	// 用法统计：**16 处赋值 / 2 处真读**。两处读都是静默错的来源：
	//   MessageLayer.tjs:2316 `if(!focusable || (!numLinks && !hasClick()))`
	//     —— 留 void 时 !void 为真，会无条件走 fallback，键盘导航全废且不报错；
	//   MessageLayer.tjs:2605 `focusable = src.focusable;`（comp 图层复制）
	//     —— 跨对象读 ⇒ 必须是实例成员，做成全局会让两张图层串值。
	//
	// 初值取 false 的依据在官方脚本自己：HistoryLayer.tjs:10（LButtonLayer 构造）
	// 和 MessageLayer.tjs:595（clear 路径）都写 `focusable = false;`
	// （注释「フォーカスは受け取らない」），只有明确需要焦点时才设 true。
	var focusable = false;
	// M2E19_END

	// M2E20_BEGIN —— NOSIZE 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**显示尺寸设置**方法 setSize(w, h)。
	// M2e-19 补上 focusable 后启动链停在 AnimationLayer.tjs:367 的
	// `setSize(32, 32);` —— clearImage() 里第一步就把图层缩到 32x32。
	//
	// 它与骨架已有的 setPos / setSizeToImageSize 是三件不同的事：
	//   setPos(l,t,w,h)        写 left/top/width/height（位置+尺寸一起）
	//   setSize(w,h)           只写 width/height（显示框大小，不动位置）
	//   setSizeToImageSize()   把 width/height 对齐到 imageWidth/imageHeight
	// 官方 ButtonLayer.tjs:323 / EditLayer.tjs:696 都覆写 setSize 并调
	// `super.setSize(w, h)` ⇒ 基类必须真写 width/height，不能留空壳。
	// KAGLayer.tjs:374 / MessageLayer.tjs:505,513 也直接调用它，
	// 之后脚本会读回 width/height 做布局算术 —— 空壳会静默算出 0。
	function setSize(w, h)
	{
		width = w;
		height = h;
	}
	// M2E20_END

	// M2E21_BEGIN —— NOIMAGEMODIFIED 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**图像脏标记**成员 imageModified（bool）。
	// M2e-20 补上 setSize 后启动链停在 MessageLayer.tjs:493 的
	// `imageModified = true;`（MessageLayer 构造，紧接 name/id 赋值之后）。
	//
	// 全库 6 处出现，全在 MessageLayer.tjs，无 var 声明 ⇒ 原生 Layer 成员。
	// 唯一真读点 MessageLayer.tjs:562 `if(imageModified)`（clear() 里判断
	// 要不要重绘图像），591 再写回 false。留 void 会让 if 恒假、跳过重绘，
	// 且不抛异常（静默错）。
	//
	// 初值取 true：构造 493 一进来就置 true，语义"新建层的图像待重绘"；
	// 与 type/face 等一样是常态位，不是无值。
	var imageModified = true;
	// M2E21_END

	// M2E22_BEGIN —— NOCOLORRECT 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**颜色矩形填充**方法 colorRect(l, t, w, h, color, mode)。
	// M2e-21 补上 imageModified 后启动链停在 MessageLayer.tjs:587 的
	// `colorRect(0, 0, imageWidth, imageHeight, 0);`（clear() 里清完图像后
	// 再把整块区域填回底色，mode 省略 ⇒ 允许 5 参调用，TJS2 兼容层已验证）。
	//
	// 全库 33 处调用（ButtonLayer/CheckBoxLayer/EditLayer/MessageLayer/
	// AnimationLayer/YesNoDialog 等），全部无声明 ⇒ 原生 Layer 成员。
	// 与 fillRect(M2e-16) 的分工：fillRect 是覆盖式填色，colorRect 带合成
	// 模式参数（mode 省略时保留目标 alpha，常用于叠色/画边框）。
	// M3 真渲染前先做空壳（同 fillRect 模式），调用面先通。
	function colorRect(l, t, w, h, color, mode) {}
	// M2E22_END

	// M2E23_BEGIN —— NOSHOWPARENTHINT 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**父层提示开关**成员 showParentHint（bool）。
	// M2e-22 补上 colorRect 后启动链停在 MessageLayer.tjs:1987 的
	// `showParentHint = false;`（link 隐藏路径，隐藏自己时不再让父层给提示）。
	//
	// 全库 6 处全是赋值、零读点（GraphicLayer.tjs 159/234/267/278 写 true，
	// MessageLayer.tjs 1987 写 false、2093 写 true）⇒ 当前启动链里 void 也够。
	// 但取官方原生默认值 true：它控制"鼠标悬停时是否显示父层的 hint 文本"，
	// 消息层默认继承父层提示是 Kirikiri 的既定行为；万一未来加读点，
	// true 是语义正确的初值，void 会让读点静默变成"不可聚焦/不显示"。
	var showParentHint = true;
	// M2E23_END

	// M2E24_BEGIN —— NOCURSORX 负向对照按此标记整段删除（cursorX/cursorY 成对）
	// 官方 LayerIntf.cpp 的**层内鼠标坐标**成员 cursorX / cursorY。
	// M2e-23 补上 showParentHint 后启动链停在 MessageLayer.tjs:607 的
	// `lastMouseX = cursorX;`（clear() 里记录当前鼠标位置，608 紧跟 cursorY）。
	//
	// 全库 10 处出现（cursorX/cursorY 永远成对），有写也有**跨对象读**：
	//   写  MessageLayer.tjs:2297/2298 `cursorX = x; cursorY = y;`（鼠标事件）
	//   读  MessageLayer.tjs:607/608、1671/1672（本层记录 lastMouseX/Y）
	//       MessageLayer.tjs:2192/2193 `parent.cursorX`（读父层）
	//       MainWindow.tjs:4006/4007 `pl.cursorX`（读任意层）
	// ⇒ 必须是实例数值成员：做成全局会让"每层的鼠标坐标"串成一份；
	//   留 void 会被赋值合法化后读到 void，lastMouseX 变 void 静默扩散。
	// 初值 0 = 原生默认（鼠标尚未进入层内时的坐标原点）。
	var cursorX = 0;
	var cursorY = 0;
	// M2E24_END

	var imageLeft = 0;
	var imageTop = 0;
	var isPrimary = false;
	var parent;
	var window;

	// M2E10_FONT_BEGIN —— M2e-10 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的 `font` 是原生属性，返回 Font 实例。
	// AnimationLayer.tjs:343 构造时读 font.face / font.height。
	var font;

	function initFont()
	{
		font = new Font();
	}
	// M2E10_FONT_END

	function Layer(win, par)
	{
		window = win;
		parent = par;
		initFont();
	}

	function finalize() {}

	function loadImages(storage, key)
	{
		// M2E51_BEGIN —— NOLVOID 负向对照按此标记整段删除
		// 官方契约（M2e-51 实测修正）：loadImages(storage, key) 无 taginfo
		// 时返回 **void** —— 官方 AnimationLayer.loadImages
		//（AnimationLayer.tjs:483-487）这样消费返回值：
		//     var taginfo = super.loadImages(elm.storage, elm.key);
		//     if(taginfo) { (Dictionary.assign incontextof taginfo)(elm, false); }
		// 骨架曾返回 -1（M2e-2 时代的「图像编号，-1 表示失败」是错误契约）
		// ⇒ -1 为真值 ⇒ 被当 taginfo 参与 incontextof 调用 ⇒ AsObject on
		// int 抛错 = M2e-49/50 的实测停点 `Cannot convert the variable type
		// ((int)-1 to Object)`。修复后语义：无 taginfo ⇒ void ⇒
		// if(taginfo) 走 false 分支。
		// （对照翻转法：NOLVOID 夹具 drop 本段后，函数体只剩下面的
		// return -1; 并被激活，精确复现同一实测停点。）
		return;
		// M2E51_END
		return -1;
	}

	function assignImages(src) {}

	function setPos(l, t, w, h)
	{
		left = l;
		top = t;
		width = w;
		height = h;
	}

	function setImagePos(x, y)
	{
		imageLeft = x;
		imageTop = y;
	}

	function setMode() {}
	function focus() {}
	function removeMode() {}

	// M2E48_BEGIN —— NODRAWTEXT 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的**文字绘制面**：drawText(x, y, text, color, opa,
	// type, shadowlevel, shadowcolor, shadowwidth, shadowofsx, shadowofsy)。
	// MessageLayer.processCh（MessageLayer.tjs:1287-1296）布局计算后调
	// lineLayer.drawText —— M2e-47 宿主空闲泵落地后 processCh 首次真执行，
	// run 44883997275 实测停点正是 `Member "drawText" does not exist`
	//（经 Conductor.tjs:189 重抛，タグ : ch 上下文）。
	//
	// 官方调用形态有两种：6 参（无阴影/无镶边）与 11 参（edge / shadow），
	// 第 7 参起给官方默认值即可同时覆盖两种形态。骨架不真画（无字形、
	// 无光栅化），只把参数收下来让布局脚本继续往前跑；返回值官方为
	// void，调用方不读。
	function drawText(x, y, text, color, opa, type,
		shadowlevel = 0, shadowcolor = 0, shadowwidth = 1,
		shadowofsx = 0, shadowofsy = 0)
	{
	}
	// M2E48_END

	// M2E52_BEGIN —— NOHOLDALPHA 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的 holdAlpha 成员：「アルファ情報を保持」——
	// loadImage 系操作时是否保留 alpha 通道的开关。官方
	// AnimationLayer.loadImages（AnimationLayer.tjs:703，M2e-51 修复后
	// 泵驱动的 l 路径真执行到此处）写它：`holdAlpha = false;`（elm.mode
	// 分支）—— run 44899892227 的实测停点
	// `Member "holdAlpha" does not exist`。骨架不真画，只把布尔状态存住
