// GalBoxLayer.tjs — GalBox 自写的 `Layer` 骨架（**非官方**，Milestone 2e-2）
//
// 官方 `Layer` 是 kirikiri2/src/core/visual/LayerIntf.cpp 里的**原生类**
// （293 KB，绑死 Windows 的 tp_stub，无法直接移植）。而 KAG 的 20 个系统脚本里
// 有 18 个写着 `extends Layer`，没有 Layer 就一个都跑不起来 —— run #34 已经把
// 根因钉死在 `KAGLayer.tjs:87` 的 `Member "Layer" does not exist`。
//
// 本文件是**过渡骨架**：纯 TJS2 脚本，只提供让 `class KAGLayer extends Layer`
// 能成立所需的成员占位，从而把「接下来还缺哪个原生成员」一条条逼出来。
// 它**不渲染、不解码图片、不做转场**，离能显示画面还差得很远。
//
// 为什么用脚本而不是原生类：TJS2 里脚本类的继承由引擎自己实现（super proxy），
// 而原生类被脚本继承时，`super.<ctor>()` 会在**脚本实例**上取原生实例 ——
// 那条路径需要另外一套原生实例注册机制。先用脚本骨架把缺口清单逼出来，
// 等清单齐了再决定哪些成员值得做成真正的原生类。
//
// 数值来源：
//   clNone / clAdapt 取自官方 LayerIntf.cpp 的注释
//     0x1fffffff = clNone （不应用颜色键 / 用图像 alpha）
//     0x01ffffff = clAdapt（自适应颜色键）
//   stt* / stst* 是转场方向与停留方式的枚举，官方定义在原生层内部；
//   这里给占位值，因为当前不做转场渲染。

// 颜色键(clNone/clAdapt)与转场枚举(stt*/stst*)**不再在这里自造** ——
// 官方常量表 native/KAG/src/system/GalBoxConsts.tjs 逐字提供了它们
// （M2e-2 时这里自造过，而且把 ststStaySrc / ststStayDest 的值**弄反了**：
//  官方是 StayDest=1、StaySrc=2）。官方常量表用的是 TJS2 的 `const`，
// 与本文件的 `global.xxx =` 同名会冲突，所以只能留一份。

// ---------------------------------------------------------------- Layer 本体
class Layer
{
	var visible = true;
	var left = 0;
	var top = 0;
	var width = 0;
	var height = 0;
	var opacity = 255;
	var absolute = 0;
	var type = 0;

	// M2E14_BEGIN —— M2e-14 负向对照（NOHITTYPE）按此标记整段删除
	// 官方 LayerIntf.cpp 的**命中测试面**：hitType + hitThreshold。
	// GraphicLayer.tjs:337-338 里 BaseLayer 构造连着写这两行：
	//     hitType = htMask;  hitThreshold = 0;
	// 其他子类还会**跨对象**写（MessageLayer.tjs:528 `lineLayer.hitType = htMask;`），
	// 说明它必须是实例成员而不是全局变量，否则所有图层会共用一个值。
	//
	// hitType = htMask 用的是官方常量表（M2e-4）里的 tTVPHitType：htMask=0 /
	// htProvince=1。这里刻意写常量名而不是 0 —— 常量表一旦回归，这一行会立刻
	// 报错，比只写裸数字多一层自检。
	var hitType = htMask;
	// M2E14_THRESHOLD_BEGIN —— NOHITTHRESHOLD 负向对照只删这一行
	// hitThreshold 与 hitType 不同：ButtonLayer.tjs:53 有 `hitThreshold = src.hitThreshold;`
	// ——它是**被读的**。所以不能留 void，必须给官方默认值 0（0 = 全域不透明；
	// 256 = 完全透过鼠标消息，见 AnimationLayer.tjs:1186）。
	var hitThreshold = 0;
	// M2E14_THRESHOLD_END
	// M2E14_END

	// M2E15_BEGIN —— M2e-15 负向对照（NOIMAGESIZE）按此标记整段删除
	// 官方 LayerIntf.cpp 的**图像面**：imageWidth/imageHeight 是原生属性，
	// setImageSize() 写它们，setSizeToImageSize() 再把图层尺寸对齐到图像尺寸。
	//
	// MainWindow.tjs:348-353 建表/裏两张背景层时连着调这几个方法：
	//     fore.base.setImageSize(scWidth, scHeight);
	//     fore.base.setSizeToImageSize();
	// 两者是**两个不同的概念**，不能合并成一个：图像尺寸是源图缓冲的大小，
	// 图层尺寸是显示框的大小（KAG 会先在图像里画，再按图层框裁切/缩放）。
	// 这里不做渲染，所以只把两个尺寸各自存住，让脚本层的算术自洽。
	//
	// 为什么要给真值 0 而不是留 void：KAGLayer.tjs:334-335 的 store() 会
	// `dic.imageWidth = imageWidth;` 原样拷走 —— void 会被一路带进
	// restore() 的 setImageSize(dic.imageWidth, dic.imageHeight)，之后
	// width/height 就算出 NaN 级污染，且不会报错（静默错）。
	var imageWidth = 0;
	var imageHeight = 0;

	function setImageSize(w, h)
	{
		imageWidth = w;
		imageHeight = h;
	}

	// M2E15_SIZETO_BEGIN —— NOSIZETOIMAGESIZE 负向对照只删这一个方法
	// 官方语义：把图层尺寸直接对齐到图像尺寸（不含 imageLeft/imageTop 偏移）。
	function setSizeToImageSize()
	{
		width = imageWidth;
		height = imageHeight;
	}
	// M2E15_SIZETO_END
	// M2E15_END

	var imageLeft = 0;
	var imageTop = 0;
	var isPrimary = false;
	var parent;
	var window;

	// M2E10_FONT_BEGIN —— M2e-10 负向对照按此标记整段删除
	// 官方 LayerIntf.cpp 的 `font` 是原生属性，返回 Font 实例。
	// AnimationLayer.tjs:343 构造时读 font.face / font.height。
	var font;

	function initFont()
	{
		font = new Font();
	}
	// M2E10_FONT_END

	function Layer(win, par)
	{
		window = win;
		parent = par;
		initFont();
	}

	function finalize() {}

	// 官方签名：loadImages(storage, key) -> 图像编号（-1 表示失败）
	function loadImages(storage, key) { return -1; }

	function assignImages(src) {}

	function setPos(l, t, w, h)
	{
		left = l;
		top = t;
		width = w;
		height = h;
	}

	function setImagePos(x, y)
	{
		imageLeft = x;
		imageTop = y;
	}

	function setMode() {}
	function focus() {}
	function removeMode() {}

	function beginTransition(method, withchildren, src, elm) {}
	function onTransitionCompleted(dest, src) {}
}
