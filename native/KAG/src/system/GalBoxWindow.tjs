// GalBoxWindow.tjs — GalBox 自写的 `Window` 骨架（**非官方**，Milestone 2e-3）
//
// 官方 `Window` 是 kirikiri2/src/core/visual/WindowIntf.cpp 里的**原生类**
// （同样绑死 Windows tp_stub）。KAG 的主窗口脚本 `MainWindow.tjs`（150 KB，
// 5893 行）第 7 行就是 `class KAGWindow extends Window`，所以没有 Window，
// 官方启动链就停在 MainWindow.tjs —— run #36 实测的阻塞点正是
// `Member "Window" does not exist` @ MainWindow.tjs:7。
//
// 与 GalBoxLayer.tjs 同理：这是**过渡骨架**，只提供成员占位，让继承成立，
// 从而把下一批缺口逼出来。它**不创建窗口、不处理输入、不绘制**。
//
// 成员清单来自对 MainWindow.tjs 的实际统计（`super.*` 调用 + 未在
// KAGWindow 内用 var 声明过的窗口相关标识符）：
//   super.Window() / finalize(...) / onCloseQuery(...) / close(...)
//   super.onMouseDown(...) / onKeyDown(...) / super.onMouseWheel(...)
//   以及 caption / visible / width / height / layer / primaryLayer /
//   children / parent / menu / fullScreen / cursor 等窗口属性。
//
// 说明：TJS2 里子类的同名成员优先于父类，所以这里多给几个成员不会覆盖
// KAGWindow 自己的定义（例如它自定义的 restore 是「栞的恢复」，与窗口的
// restore 不是一回事）。

// 光标形状常量(cr*)同样**不再自造** —— 官方常量表 GalBoxConsts.tjs 逐字提供
// （M2e-3 时这里自造过 crArrow=0，官方其实是 -2）。

class Window
{
	// ---- 窗口属性（占位） ----
	var caption = "";
	var captionLayer;
	var visible = true;
	var width = 640;
	var height = 480;
	var layer;
	var primaryLayer;
	var children = [];
	var parent;
	var menu;
	var fullScreen = false;
	var focused = false;
	var cursor = 0;
	var hintText = "";
	var isValidFlag = true;

	// M2E8_STYLE_BEGIN —— M2e-8 负向对照夹具按这对标记整段删掉，用来证明
	// 这三个成员确实是官方 MainWindow.tjs:313-320 所必需，不是摆设。
	// 常量 bsSingle / bsDialog 已在官方常量表 GalBoxConsts.tjs 里（M2e-4 逐字抄），
	// 这里缺的只是 Window 原生对象上的可写属性。
	var borderStyle = 1;   // bsSingle
	var innerSunken = false;
	var showScrollBars = false;
	// M2E8_STYLE_END

	// M2E28_BEGIN —— NOWINLEFT 负向对照按此标记整段删除
	// 官方 WindowIntf 的**窗口左上角坐标** left / top（屏幕坐标）。
	// M2e-27 补上 VideoOverlay 后启动链停在 MainWindow.tjs:438：
	//   `if(this.width + this.left > System.desktopLeft + System.desktopWidth)`
	//   `left = ((System.desktopWidth - this.width) >> 1) + System.desktopLeft;`
	//   （439/441 两行还会回写 left/top 做居中修正）
	//
	// 注意归属：这是 **Window** 的成员，不是 Layer 的 —— Layer 骨架
	// 早在 M2e-2 就有 var left/top（GalBoxLayer.tjs:34-35），别被同名骗了。
	// 全库读点都在 KAGWindow / MainWindow 里（this.left、left = …），
	// 初值 0 = 原生默认（窗口初始位置）。
	var left = 0;
	var top = 0;
	// M2E28_END

	function Window()
	{
		// M2e-7：官方 Window 构造时会带出一个 Menu 对象；KAGWindow 的
		// KAGWindow_createMenus() 直接写 `menu.add(...)`，不会自己 new Menu。
		// 骨架里补上这一句，才能让菜单脚本继续往下走。
		menu = new Menu(this);
	}

	function finalize() {}

	// ---- 生命周期 ----
	function close() {}
	function onCloseQuery(q) {}
	function onResize(width, height) {}
	function onTimer(tick) {}
	function onDraw() {}
	function onActivate(activate) {}
	function onDeactivate() {}

	// ---- 输入 ----
	function onMouseDown(x, y, button, shift) {}
	function onMouseUp(x, y, button, shift) {}
	function onMouseMove(x, y, shift) {}
	function onMouseWheel(shift, x, y) {}
	function onKeyDown(keycode, shift) {}
	function onKeyUp(keycode, shift) {}
	function onKeyPress(keycode) {}

	// ---- 属性设置（占位） ----
	function setCaption(cap) { caption = cap; }
	function setMenu(m) { menu = m; }
	function setSize(w, h) { width = w; height = h; }
	function setCursor(c) { cursor = c; }
	function setFullScreen(flag) { fullScreen = flag; }
	function setFocused(flag) { focused = flag; }
	function setHint(t) { hintText = t; }
	function getWidth() { return width; }
	function getHeight() { return height; }

	// 官方 KAGWindow 构造里紧接着会调 setInnerSize(scWidth, scHeight)，
	// 并用 add(child) 把 Timer / Layer / Conductor 等子对象登记到窗口。
	// 骨架只做占位：尺寸记在 width/height，子对象记在 children。
	function setInnerSize(w, h) { width = w; height = h; }
	function add(child) { children.add(child); return child; }

	// ---- 绘制 / 重绘（占位，不做任何事） ----
	function redraw() {}
	function restore() {}
	function minimize() {}
	function maximize() {}
	function clear() {}

	// ---- 图层（占位） ----
	function createLayer(w, h, type) {}
}
